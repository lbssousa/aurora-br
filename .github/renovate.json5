{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],

  // Do not rebase when the default branch is updated
  "rebaseWhen": "never",
    customManagers: [
    {
      customType: 'regex',
      managerFilePatterns: [
        '/^Justfile$/',
      ],
      matchStrings: [
        '(?<justName>.+?)\\s:=\\s"(?<packageName>\\S+):(?<currentValue>\\S+)@(?<currentDigest>sha256:[a-f0-9]+?)"',
      ],
      datasourceTemplate: 'docker',
    },
    {
      // Track Epson ESC/P-R driver version in build_files/br/10-epson-printer.sh
      customType: 'regex',
      managerFilePatterns: ['/^build_files/br/10-epson-printer\\.sh$/'],
      matchStrings: [
        '# renovate: datasource=custom\\.epson-escpr\\nESCPR_VERSION="(?<currentValue>[^"]+)"',
        '# renovate: datasource=custom\\.epson-printer-utility\\nUTILITY_VERSION="(?<currentValue>[^"]+)"',
      ],
      datasourceTemplate: 'custom.epson',
      depNameTemplate: 'epson-inkjet-printer-escpr',
    },
    {
      // Track biglinux/big-parental-controls commit SHA
      customType: 'regex',
      managerFilePatterns: ['/^build_files/br/20-big-parental-controls\\.sh$/'],
      matchStrings: [
        'BPC_COMMIT="(?<currentDigest>[a-f0-9]{40})"',
      ],
      datasourceTemplate: 'github-tags',
      depNameTemplate: 'biglinux/big-parental-controls',
      currentValueTemplate: 'main',
    },
    ],

  "packageRules": [
    {
      "automerge": true,
      "matchUpdateTypes": ["pin", "pinDigest"]
    },
    {
      "automerge": true,
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["digest"]
    },
    {
      "matchUpdateTypes": ["pin", "digest", "pinDigest"],
      "matchPackageNames": ["ghcr.io/jasonn3/build-container-installer", "ghcr.io/hhd-dev/rechunk"],
      "automerge": false
    },
    {
      "automerge": true,
      "matchUpdateTypes": ["digest"],
      "matchDepNames": [
        "quay.io/fedora-ostree-desktops/kinoite",
        "ghcr.io/ublue-os/brew",
        "ghcr.io/get-aurora-dev/common"
      ]
    },
    {
      // Disable automatic Fedora major version bumps to prevent unintended OS upgrades.
      // Major version changes (e.g. F43→F44) require deliberate testing and migration.
      "matchDepNames": ["quay.io/fedora-ostree-desktops/kinoite"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
